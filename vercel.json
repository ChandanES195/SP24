{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]git
}